@{
    ViewData["Title"] = "Bảng xếp hạng";
    var tournaments = ViewBag.Tournaments as List<StudentFootballLeague.BusinessLogic.DTOs.TournamentReadDto> ?? new List<StudentFootballLeague.BusinessLogic.DTOs.TournamentReadDto>();
    var selectedTour = ViewBag.SelectedTournament as StudentFootballLeague.BusinessLogic.DTOs.TournamentReadDto;
    var groupA = ViewBag.GroupA as List<StudentFootballLeague.BusinessLogic.DTOs.StandingReadDto> ?? new List<StudentFootballLeague.BusinessLogic.DTOs.StandingReadDto>();
    var groupB = ViewBag.GroupB as List<StudentFootballLeague.BusinessLogic.DTOs.StandingReadDto> ?? new List<StudentFootballLeague.BusinessLogic.DTOs.StandingReadDto>();
    var topScorers = ViewBag.TopScorers as List<StudentFootballLeague.BusinessLogic.DTOs.TopScorerDto> ?? new List<StudentFootballLeague.BusinessLogic.DTOs.TopScorerDto>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-bar-chart-line-fill me-2 text-success"></i>Bảng Xếp Hạng & Thống Kê</h3>
        <p class="text-muted mb-0">Tự động cập nhật điểm số, hiệu số bàn thắng và điểm kỷ luật Fair-play theo thời gian thực</p>
    </div>
    <div>
        <form method="get" class="d-flex align-items-center">
            <label class="me-2 fw-bold text-nowrap">Chọn mùa giải:</label>
            <select name="tournamentId" class="form-select form-select-sm" onchange="this.form.submit()">
                @foreach (var t in tournaments)
                {
                    <option value="@t.TournamentId" selected="@(selectedTour?.TournamentId == t.TournamentId ? "selected" : null)">
                        @t.Name (@t.Season)
                    </option>
                }
            </select>
        </form>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Bảng A -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-dark text-white py-3 rounded-top-4 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-warning"><i class="bi bi-table me-2"></i>Bảng A (Group A)</h5>
                <span class="badge bg-primary">Vòng Bảng</span>
            </div>
            <div class="card-body p-3">
                @await Html.PartialAsync("_StandingsTablePartial", groupA)
            </div>
        </div>
    </div>

    <!-- Bảng B -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-dark text-white py-3 rounded-top-4 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-warning"><i class="bi bi-table me-2"></i>Bảng B (Group B)</h5>
                <span class="badge bg-primary">Vòng Bảng</span>
            </div>
            <div class="card-body p-3">
                @await Html.PartialAsync("_StandingsTablePartial", groupB)
            </div>
        </div>
    </div>
</div>

<!-- Top Ghi Bàn Giải Đấu -->
<div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-dark text-white py-3 rounded-top-4 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-warning"><i class="bi bi-trophy-fill me-2"></i>Bảng Xếp Hạng Vua Phá Lưới (Top Scorers)</h5>
        <span class="badge bg-danger">Danh hiệu cá nhân</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="text-center">
                        <th style="width: 50px;">Hạng</th>
                        <th class="text-start">Cầu thủ</th>
                        <th>MSSV</th>
                        <th>Số áo</th>
                        <th>Vị trí</th>
                        <th class="text-start">Đội bóng</th>
                        <th>Bàn thắng</th>
                        <th>Thẻ vàng</th>
                        <th>Thẻ đỏ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (topScorers.Any())
                    {
                        foreach (var s in topScorers)
                        {
                            <tr class="text-center">
                                <td>
                                    <span class="badge @(s.Rank == 1 ? "bg-warning text-dark" : (s.Rank <= 3 ? "bg-info text-dark" : "bg-light text-muted border")) rounded-pill">
                                        @s.Rank
                                    </span>
                                </td>
                                <td class="text-start fw-bold">@s.FullName</td>
                                <td><code>@s.StudentCode</code></td>
                                <td><span class="badge bg-light text-dark border">#@s.JerseyNumber</span></td>
                                <td><span class="badge bg-secondary">@s.Position</span></td>
                                <td class="text-start">@s.TeamName</td>
                                <td class="fw-bold fs-6 text-danger">@s.GoalsScored</td>
                                <td><span class="badge bg-warning text-dark">@s.YellowCards</span></td>
                                <td><span class="badge bg-danger">@s.RedCards</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">Chưa có dữ liệu bàn thắng nào cho giải đấu này.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
