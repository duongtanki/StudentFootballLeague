@model StudentFootballLeague.DataAccess.Entities.Team
@{
    ViewData["Title"] = "Quản lý Đội bóng của tôi";
    var tournaments = ViewBag.AvailableTournaments as List<StudentFootballLeague.BusinessLogic.DTOs.TournamentReadDto> ?? new List<StudentFootballLeague.BusinessLogic.DTOs.TournamentReadDto>();
}

@if (Model == null)
{
    <!-- Chưa tạo đội bóng -->
    <div class="row justify-content-center mt-4">
        <div class="col-md-7">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-shield-plus me-2"></i>KHỞI TẠO HỒ SƠ ĐỘI BÓNG</h4>
                    <small class="text-white-50">Bước đầu tiên để đưa đội bóng sinh viên của bạn tham gia giải đấu</small>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateTeam" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên đội bóng <span class="text-danger">*</span></label>
                            <input name="TeamName" class="form-control" placeholder="Ví dụ: FC Kỹ Thuật Phần Mềm K18" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Khoa / Viện / Câu lạc bộ trực thuộc <span class="text-danger">*</span></label>
                            <input name="FacultyOrClub" class="form-control" placeholder="Ví dụ: Khoa Kỹ thuật Phần mềm (SE)" required />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Màu áo thi đấu chính <span class="text-danger">*</span></label>
                                <input name="HomeKitColor" class="form-control" placeholder="Ví dụ: Đỏ - Trắng" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Logo đội bóng (Đường dẫn ảnh)</label>
                                <input name="LogoUrl" class="form-control" placeholder="/images/logos/my-team.png" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm mt-3">
                            TẠO ĐỘI BÓNG & TIẾP TỤC
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
else
{
    var hasGK = Model.Players != null && Model.Players.Any(p => p.Position == "GK");
    var totalPlayers = Model.Players?.Count ?? 0;

    <!-- Header Thông tin Đội bóng -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-auto">
                    @if (!string.IsNullOrEmpty(Model.LogoUrl))
                    {
                        <img src="@Model.LogoUrl" alt="logo" class="rounded-circle shadow-sm" style="width: 80px; height: 80px; object-fit: cover;" onerror="this.src='/images/default-team.png';" />
                    }
                    else
                    {
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-3" style="width: 80px; height: 80px;">
                            @Model.TeamName.Substring(0, Math.Min(2, Model.TeamName.Length)).ToUpper()
                        </div>
                    }
                </div>
                <div class="col">
                    <h3 class="fw-bold text-dark mb-1">@Model.TeamName</h3>
                    <p class="text-muted mb-1"><i class="bi bi-building me-1"></i>Trực thuộc: <strong>@Model.FacultyOrClub</strong></p>
                    <span class="badge bg-light text-dark border me-2"><i class="bi bi-palette me-1"></i>Màu áo: @Model.HomeKitColor</span>
                    <span class="badge @(totalPlayers >= 7 ? "bg-success" : "bg-warning text-dark")">
                        <i class="bi bi-people me-1"></i>@totalPlayers Cầu thủ
                    </span>
                    <span class="badge @(hasGK ? "bg-success" : "bg-danger")">
                        <i class="bi bi-shield-check me-1"></i>@(hasGK ? "Đã có Thủ môn (GK)" : "Thiếu Thủ môn (GK)")
                    </span>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-primary fw-bold shadow-sm" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#addPlayerModal">
                        <i class="bi bi-person-plus-fill me-1"></i> Thêm Cầu Thủ
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng Thông Báo Đăng Ký Giải & Cảnh Báo Quy Định -->
    <div class="row mb-4">
        <!-- Đăng ký giải đấu -->
        <div class="col-lg-6 mb-3 mb-lg-0">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-header bg-dark text-white py-3 rounded-top-4">
                    <h5 class="mb-0 fw-bold text-warning"><i class="bi bi-trophy me-2"></i>Đăng Ký Tham Gia Mùa Giải</h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.Registrations != null && Model.Registrations.Any())
                    {
                        <h6 class="fw-bold mb-3">Hồ sơ đã gửi:</h6>
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var reg in Model.Registrations)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        <strong>@(reg.Tournament?.Name ?? "Giải bóng đá")</strong>
                                        <small class="text-muted d-block">Bảng đấu: @(reg.GroupName ?? "Chưa phân bảng")</small>
                                    </div>
                                    <div>
                                        @if (reg.ApprovalStatus == "Approved")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã phê duyệt</span>
                                        }
                                        else if (reg.ApprovalStatus == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ BTC duyệt</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Bị từ chối: @reg.RejectReason</span>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }

                    <form asp-action="RegisterTournament" method="post" class="mt-3">
                        <label class="form-label fw-bold">Chọn giải đấu mở đăng ký:</label>
                        <div class="input-group">
                            <select name="tournamentId" class="form-select" required>
                                <option value="">-- Chọn giải đấu --</option>
                                @foreach (var t in tournaments)
                                {
                                    <option value="@t.TournamentId">@t.Name (Hạn: @t.RegistrationDeadline.ToString("dd/MM/yyyy"))</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-warning fw-bold text-dark" @(totalPlayers < 7 || !hasGK ? "disabled" : "")>
                                <i class="bi bi-send-fill me-1"></i> Nộp Hồ Sơ
                            </button>
                        </div>
                        @if (totalPlayers < 7 || !hasGK)
                        {
                            <small class="text-danger d-block mt-2">
                                <i class="bi bi-exclamation-circle me-1"></i>Đội bóng phải có tối thiểu 7 cầu thủ và ít nhất 1 Thủ môn (GK) mới được nộp hồ sơ.
                            </small>
                        }
                    </form>
                </div>
            </div>
        </div>

        <!-- Quy định đăng ký -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 bg-light h-100">
                <div class="card-header bg-white py-3 rounded-top-4">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-info-circle-fill text-primary me-2"></i>Quy Định Điều Lệ Giải</h5>
                </div>
                <div class="card-body p-4">
                    <ul class="list-unstyled mb-0 small text-secondary">
                        <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i>Mỗi sinh viên chỉ được phép đăng ký thi đấu cho duy nhất 1 đội bóng trong mùa giải.</li>
                        <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i>Số áo thi đấu từ 1 đến 99 và không được trùng lặp trong cùng một đội bóng.</li>
                        <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i>Đội bóng phải có tối thiểu 7 cầu thủ và tối đa 15 cầu thủ, bao gồm ít nhất 1 Thủ môn (GK).</li>
                        <li><i class="bi bi-check2 text-success me-2"></i>Sau khi giải đấu bắt đầu hoặc hết hạn đăng ký, danh sách cầu thủ sẽ bị khóa sổ và không thể thay đổi.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh Sách Cầu Thủ Của Đội -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-people-fill text-primary me-2"></i>Danh Sách Cầu Thủ (@totalPlayers)</h5>
            <button type="button" class="btn btn-sm btn-outline-primary fw-bold" data-bs-toggle="modal" data-bs-target="#addPlayerModal">
                <i class="bi bi-plus-lg me-1"></i> Thêm cầu thủ
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-center">
                            <th>Số áo</th>
                            <th class="text-start">Họ và tên</th>
                            <th>MSSV</th>
                            <th>Vị trí</th>
                            <th>Ngày sinh</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Players != null && Model.Players.Any())
                        {
                            foreach (var player in Model.Players.OrderBy(p => p.JerseyNumber))
                            {
                                <tr class="text-center">
                                    <td>
                                        <span class="badge bg-light text-dark border fs-6">#@player.JerseyNumber</span>
                                    </td>
                                    <td class="text-start fw-bold">@player.FullName</td>
                                    <td><code>@player.StudentCode</code></td>
                                    <td>
                                        @if (player.Position == "GK")
                                        {
                                            <span class="badge bg-warning text-dark">Thủ môn (GK)</span>
                                        }
                                        else if (player.Position == "DF")
                                        {
                                            <span class="badge bg-info text-dark">Hậu vệ (DF)</span>
                                        }
                                        else if (player.Position == "MF")
                                        {
                                            <span class="badge bg-primary">Tiền vệ (MF)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Tiền đạo (FW)</span>
                                        }
                                    </td>
                                    <td>@player.DateOfBirth.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge bg-success">Đủ điều kiện</span>
                                    </td>
                                    <td>
                                        <form asp-action="DeletePlayer" asp-route-id="@player.PlayerId" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa cầu thủ này khỏi đội bóng?');" class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Xóa cầu thủ">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Chưa có cầu thủ nào. Hãy bấm nút "Thêm Cầu Thủ" ở trên để tạo danh sách!</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Render PartialView Modal Form Thêm Cầu Thủ -->
    @await Html.PartialAsync("_PlayerFormModalPartial", new StudentFootballLeague.BusinessLogic.DTOs.PlayerCreateDto())
}
