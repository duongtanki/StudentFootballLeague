@model StudentFootballLeague.DataAccess.Entities.Team
@{
    ViewData["Title"] = "Quản lý Đội bóng của tôi";
    var tournaments = ViewBag.AvailableTournaments as List<StudentFootballLeague.BusinessLogic.DTOs.TournamentReadDto> ?? new List<StudentFootballLeague.BusinessLogic.DTOs.TournamentReadDto>();
}

@if (Model == null)
{
    <div class="row justify-content-center my-4">
        <div class="col-md-8 col-lg-7">
            <div class="apex-panel overflow-hidden">
                <div class="apex-panel-header">
                    <div>
                        <div class="apex-label-caps" style="color: var(--apex-mint);">Khởi tạo đội bóng</div>
                        <h1 class="apex-display fw-bold fs-3 mb-0 text-white">KHỞI TẠO HỒ SƠ ĐỘI BÓNG</h1>
                    </div>
                    <i class="bi bi-shield-plus fs-3" style="color: var(--apex-crimson);"></i>
                </div>
                <div class="p-4">
                    <p class="small text-muted mb-4">Bước đầu tiên để đưa đội bóng sinh viên của bạn tham gia mùa giải.</p>
                    <form asp-action="CreateTeam" method="post">
                        <div class="mb-3">
                            <label class="form-label small apex-label-caps">Tên đội bóng <span class="text-danger">*</span></label>
                            <input name="TeamName" class="form-control" placeholder="Ví dụ: FC Kỹ Thuật Phần Mềm K18" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small apex-label-caps">Khoa / Viện / CLB trực thuộc <span class="text-danger">*</span></label>
                            <input name="FacultyOrClub" class="form-control" placeholder="Ví dụ: Khoa Kỹ thuật Phần mềm (SE)" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label small apex-label-caps">Màu áo thi đấu chính <span class="text-danger">*</span></label>
                            <input name="HomeKitColor" class="form-control" placeholder="Ví dụ: Đỏ - Trắng" required />
                        </div>
                        <button type="submit" class="btn btn-apex-primary w-100 py-2">
                            Tạo đội bóng &amp; Tiếp tục
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
else
{
    var activePlayers = Model.Players?.Where(p => p.IsActive).OrderBy(p => p.JerseyNumber).ToList() ?? new List<StudentFootballLeague.DataAccess.Entities.Player>();
    var hasGK = activePlayers.Any(p => p.Position == "GK");
    var gkCount = activePlayers.Count(p => p.Position == "GK");
    var dfCount = activePlayers.Count(p => p.Position == "DF");
    var mfCount = activePlayers.Count(p => p.Position == "MF");
    var fwCount = activePlayers.Count(p => p.Position == "FW");
    var totalPlayers = activePlayers.Count;
    var progressPct = Math.Min(100, (int)Math.Round(totalPlayers * 100.0 / 15));
    var initials = Model.TeamName.Substring(0, Math.Min(2, Model.TeamName.Length)).ToUpper();

    <!-- Team Header Banner -->
    <section class="apex-hero p-4 mb-4">
        <div class="row align-items-center g-3 position-relative" style="z-index: 2;">
            <div class="col-auto">
                <div class="apex-crest apex-crest--lg">@initials</div>
            </div>
            <div class="col">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <h1 class="apex-display fw-bold fs-2 mb-0 text-white">@Model.TeamName</h1>
                    @if (totalPlayers >= 7 && hasGK)
                    {
                        <span class="apex-badge apex-badge--live">Đủ điều kiện thi đấu (@totalPlayers/15)</span>
                    }
                    else
                    {
                        <span class="apex-badge apex-badge--postponed">Cần bổ sung đội hình (@totalPlayers/15)</span>
                    }
                </div>
                <p class="small text-muted mb-0">
                    Trực thuộc: <strong class="text-white">@Model.FacultyOrClub</strong>
                    <span class="mx-2">•</span>
                    Màu áo: <strong class="text-white">@Model.HomeKitColor</strong>
                </p>
            </div>
            <div class="col-md-auto">
                <button type="button" class="btn btn-apex-primary px-3 py-2" data-bs-toggle="modal" data-bs-target="#addPlayerModal">
                    <i class="bi bi-person-plus-fill me-1"></i> Thêm cầu thủ mới
                </button>
            </div>
        </div>
    </section>

    <!-- 4 KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="apex-kpi-card">
                <div class="apex-label-caps text-muted mb-1">Tổng số cầu thủ</div>
                <div class="apex-kpi-value">@totalPlayers <span class="fs-5 text-muted">/ 15</span></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="apex-kpi-card">
                <div class="apex-label-caps text-muted mb-1">Thủ môn (GK)</div>
                <div class="apex-kpi-value" style="color: @(hasGK ? "var(--apex-mint)" : "var(--apex-crimson)");">@gkCount</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="apex-kpi-card">
                <div class="apex-label-caps text-muted mb-1">Hồ sơ giải đã nộp</div>
                <div class="apex-kpi-value" style="color: var(--apex-violet-soft);">@(Model.Registrations?.Count ?? 0)</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="apex-kpi-card">
                <div class="apex-label-caps text-muted mb-1">Hoàn thiện đội hình</div>
                <div class="apex-kpi-value" style="color: var(--apex-cyan);">@progressPct%</div>
            </div>
        </div>
    </div>

    <!-- Registration & Rules -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="apex-panel h-100">
                <div class="apex-panel-header">
                    <h2 class="apex-display fw-bold fs-4 mb-0 text-white">
                        <i class="bi bi-trophy me-2" style="color: var(--apex-pink-soft);"></i>HỒ SƠ ĐĂNG KÝ MÙA GIẢI
                    </h2>
                </div>
                <div class="p-4">
                    @if (Model.Registrations != null && Model.Registrations.Any())
                    {
                        <div class="d-flex flex-column gap-2 mb-4">
                            @foreach (var reg in Model.Registrations)
                            {
                                <div class="p-3 rounded-2 d-flex justify-content-between align-items-center" style="background: var(--apex-lowest); border: 1px solid var(--apex-border-subtle);">
                                    <div>
                                        <div class="fw-bold text-white">@(reg.Tournament?.Name ?? "Giải bóng đá")</div>
                                        <small class="text-muted">Bảng đấu: @(reg.GroupName ?? "Chưa phân bảng")</small>
                                    </div>
                                    <div>
                                        @if (reg.ApprovalStatus == "Approved")
                                        {
                                            <span class="apex-badge apex-badge--live">Đã phê duyệt</span>
                                        }
                                        else if (reg.ApprovalStatus == "Pending")
                                        {
                                            <span class="apex-badge apex-badge--postponed">Chờ BTC duyệt</span>
                                        }
                                        else
                                        {
                                            <span class="apex-badge apex-badge--cancelled" title="@reg.RejectReason">Từ chối: @reg.RejectReason</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <form asp-action="RegisterTournament" method="post">
                        <label class="form-label small apex-label-caps">Chọn giải đấu đang mở đăng ký</label>
                        <div class="input-group">
                            <select name="tournamentId" class="form-select" required>
                                <option value="">-- Chọn giải đấu --</option>
                                @foreach (var t in tournaments)
                                {
                                    <option value="@t.TournamentId">@t.Name (Hạn: @t.RegistrationDeadline.ToString("dd/MM/yyyy"))</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-apex-primary px-3" @(totalPlayers < 7 || !hasGK ? "disabled" : "")>
                                Nộp hồ sơ
                            </button>
                        </div>
                        @if (totalPlayers < 7 || !hasGK)
                        {
                            <small class="d-block mt-2" style="color: var(--apex-pink-soft);">
                                <i class="bi bi-exclamation-circle me-1"></i>Đội bóng cần tối thiểu 7 cầu thủ và ít nhất 1 Thủ môn (GK) trước khi nộp hồ sơ.
                            </small>
                        }
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="apex-panel h-100">
                <div class="apex-panel-header">
                    <h2 class="apex-display fw-bold fs-4 mb-0 text-white">
                        <i class="bi bi-journal-check me-2" style="color: var(--apex-mint);"></i>QUY ĐỊNH ĐIỀU LỆ SÂN 7
                    </h2>
                    <span class="apex-badge apex-badge--scheduled">FPT VFF 2026</span>
                </div>
                <div class="p-4">
                    <ul class="list-unstyled small text-muted d-flex flex-column gap-2 mb-4">
                        <li><i class="bi bi-check-circle-fill me-2" style="color: var(--apex-mint);"></i>Quân số hợp lệ: tối thiểu 7 cầu thủ, tối đa 15 cầu thủ đang hoạt động.</li>
                        <li><i class="bi bi-check-circle-fill me-2" style="color: var(--apex-mint);"></i>Bắt buộc có ít nhất 1 Thủ môn (GK) trong danh sách đăng ký.</li>
                        <li><i class="bi bi-check-circle-fill me-2" style="color: var(--apex-mint);"></i>Số áo từ 1 đến 99, không trùng lặp giữa các cầu thủ đang hoạt động trong đội.</li>
                        <li><i class="bi bi-check-circle-fill me-2" style="color: var(--apex-mint);"></i>Xóa cầu thủ sẽ dùng xóa mềm, bảo toàn lịch sử bàn thắng và thẻ phạt.</li>
                    </ul>
                    <div class="p-3 rounded-2" style="background: var(--apex-lowest); border: 1px solid var(--apex-border-subtle);">
                        <div class="d-flex justify-content-between small mb-2">
                            <span class="apex-label-caps text-muted">Chỉ số hoàn thiện đội hình</span>
                            <span class="fw-bold apex-tabular" style="color: var(--apex-mint);">@totalPlayers / 15 (@progressPct%)</span>
                        </div>
                        <div class="progress" style="height: 8px; background: var(--apex-surface);">
                            <div class="progress-bar" role="progressbar" style="width: @progressPct%; background: linear-gradient(90deg, var(--apex-violet), var(--apex-mint));"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Squad Players Table -->
    <div class="apex-panel overflow-hidden">
        <div class="apex-panel-header flex-wrap">
            <h2 class="apex-display fw-bold fs-4 mb-0 text-white">
                <i class="bi bi-people-fill me-2" style="color: var(--apex-crimson);"></i>DANH SÁCH ĐỘI HÌNH (@totalPlayers)
            </h2>
            <div class="d-flex flex-wrap gap-1">
                <button type="button" class="apex-tab-btn py-1 px-2 active" onclick="filterSquad('ALL', this)">Tất cả (@totalPlayers)</button>
                <button type="button" class="apex-tab-btn py-1 px-2" onclick="filterSquad('GK', this)">GK (@gkCount)</button>
                <button type="button" class="apex-tab-btn py-1 px-2" onclick="filterSquad('DF', this)">DF (@dfCount)</button>
                <button type="button" class="apex-tab-btn py-1 px-2" onclick="filterSquad('MF', this)">MF (@mfCount)</button>
                <button type="button" class="apex-tab-btn py-1 px-2" onclick="filterSquad('FW', this)">FW (@fwCount)</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table apex-table align-middle mb-0 apex-tabular" id="squadTable">
                <thead>
                    <tr class="text-center">
                        <th>Số áo</th>
                        <th class="text-start">Họ và tên</th>
                        <th>MSSV</th>
                        <th>Vị trí</th>
                        <th>Ngày sinh</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (activePlayers.Any())
                    {
                        foreach (var player in activePlayers)
                        {
                            <tr class="text-center squad-row" data-pos="@player.Position">
                                <td>
                                    <span class="apex-crest mx-auto" style="width: 36px; height: 36px; font-size: 0.95rem; background: @(player.Position == "GK" ? "var(--apex-crimson)" : "var(--apex-high)");">
                                        #@player.JerseyNumber
                                    </span>
                                </td>
                                <td class="text-start fw-bold text-white">@player.FullName</td>
                                <td><code>@player.StudentCode</code></td>
                                <td><span class="apex-badge apex-badge--scheduled">@player.Position</span></td>
                                <td>@player.DateOfBirth.ToString("dd/MM/yyyy")</td>
                                <td><span class="apex-badge apex-badge--live">Sẵn sàng</span></td>
                                <td>
                                    <form asp-action="DeletePlayer" asp-route-id="@player.PlayerId" method="post" onsubmit="return confirm('Xóa cầu thủ @player.FullName khỏi danh sách đội hiện tại?');" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa cầu thủ">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Chưa có cầu thủ nào. Nhấn "Thêm cầu thủ mới" để tạo danh sách!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @await Html.PartialAsync("_PlayerFormModalPartial", new StudentFootballLeague.BusinessLogic.DTOs.PlayerCreateDto())

    <!-- Modal Chỉnh Sửa Cầu Thủ -->
    <div class="modal fade" id="editPlayerModal" tabindex="-1" aria-labelledby="editPlayerModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="MyTeam" asp-action="EditPlayer" method="post">
                    <input type="hidden" id="editPlayerId" name="id" />
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title" id="editPlayerModalLabel"><i class="bi bi-pencil-square me-2"></i>Chỉnh Sửa Thông Tin Cầu Thủ</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="editStudentCode" class="form-label fw-bold">Mã số sinh viên (MSSV) <span class="text-danger">*</span></label>
                            <input type="text" id="editStudentCode" name="StudentCode" class="form-control" placeholder="Ví dụ: HE180101" pattern="^[A-Z]{2}\d{6}$" required />
                            <small class="text-muted">Định dạng gồm 2 chữ cái viết hoa và 6 chữ số (VD: HE180101)</small>
                        </div>

                        <div class="mb-3">
                            <label for="editFullName" class="form-label fw-bold">Họ và tên cầu thủ <span class="text-danger">*</span></label>
                            <input type="text" id="editFullName" name="FullName" class="form-control" maxlength="100" required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="editJerseyNumber" class="form-label fw-bold">Số áo thi đấu (1-99) <span class="text-danger">*</span></label>
                                <input type="number" id="editJerseyNumber" name="JerseyNumber" min="1" max="99" class="form-control" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="editPosition" class="form-label fw-bold">Vị trí thi đấu <span class="text-danger">*</span></label>
                                <select id="editPosition" name="Position" class="form-select" required>
                                    <option value="GK">Thủ môn (GK)</option>
                                    <option value="DF">Hậu vệ (DF)</option>
                                    <option value="MF">Tiền vệ (MF)</option>
                                    <option value="FW">Tiền đạo (FW)</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="editDateOfBirth" class="form-label fw-bold">Ngày sinh <span class="text-danger">*</span></label>
                            <input type="date" id="editDateOfBirth" name="DateOfBirth" class="form-control" required />
                        </div>

                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="editIsActive" name="IsActive" value="true" checked />
                            <input type="hidden" name="IsActive" value="false" />
                            <label class="form-check-label fw-bold" for="editIsActive">Đủ điều kiện thi đấu (Đang hoạt động)</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Lưu Thay Đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const editButtons = document.querySelectorAll('.btn-edit-player');
            editButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    document.getElementById('editPlayerId').value = this.dataset.playerId;
                    document.getElementById('editStudentCode').value = this.dataset.studentCode;
                    document.getElementById('editFullName').value = this.dataset.fullName;
                    document.getElementById('editJerseyNumber').value = this.dataset.jerseyNumber;
                    document.getElementById('editPosition').value = this.dataset.position;
                    document.getElementById('editDateOfBirth').value = this.dataset.dob;
                    document.getElementById('editIsActive').checked = this.dataset.isActive === 'true';
                });
            });
        });
    </script>
}

@section Scripts {
    <script>
        function filterSquad(pos, btn) {
            document.querySelectorAll('#squadTable .squad-row').forEach(function (row) {
                row.style.display = (pos === 'ALL' || row.getAttribute('data-pos') === pos) ? '' : 'none';
            });
            btn.parentElement.querySelectorAll('button').forEach(function (b) { b.classList.remove('active'); });
            btn.classList.add('active');
        }
    </script>
}
