@model StudentFootballLeague.BusinessLogic.DTOs.MatchReadDto
@{
    var isLive = string.Equals(Model.Status, "InProgress", System.StringComparison.OrdinalIgnoreCase);
    var showScore = isLive || string.Equals(Model.Status, "Completed", System.StringComparison.OrdinalIgnoreCase);
    string Monogram(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "FC";
        var parts = name.Split(' ', System.StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Substring(0, System.Math.Min(2, name.Length)).ToUpper();
    }
}

<article class="apex-match-card @(isLive ? "apex-match-card--live" : "") h-100 d-flex flex-column overflow-hidden">
    <div class="px-3 py-2 d-flex justify-content-between align-items-center gap-2 border-bottom" style="border-color: var(--apex-border-subtle) !important; background: rgba(28, 5, 31, 0.45);">
        <div class="apex-label-caps text-muted text-truncate">
            <span>@Model.RoundName</span>
            @if (!string.IsNullOrEmpty(Model.GroupName))
            {
                <span class="mx-1">•</span>
                <span style="color: var(--apex-violet-soft);">@Model.GroupName</span>
            }
        </div>
        <match-status status="@Model.Status"></match-status>
    </div>

    <div class="p-3 p-md-4 flex-grow-1 d-flex align-items-center">
        <div class="row w-100 align-items-center text-center g-2 mx-0">
            <div class="col-4 px-1 d-flex flex-column align-items-center">
                <div class="apex-crest mb-2">@Monogram(Model.HomeTeamName)</div>
                <div class="fw-bold text-white small text-truncate w-100" title="@Model.HomeTeamName">@Model.HomeTeamName</div>
                <small class="text-muted" style="font-size: 0.72rem;">Chủ nhà</small>
            </div>

            <div class="col-4 px-1">
                @if (showScore)
                {
                    <div class="apex-score @(isLive ? "apex-score--live" : "")">
                        @Model.HomeScore <span class="text-muted" style="font-size: 1.4rem;">-</span> @Model.AwayScore
                    </div>
                    @if (Model.HomePenalty.HasValue && Model.AwayPenalty.HasValue)
                    {
                        <small class="d-block mt-1 apex-tabular" style="color: var(--apex-violet-soft);">Pen @Model.HomePenalty - @Model.AwayPenalty</small>
                    }
                    <div class="apex-label-caps mt-1" style="color: @(isLive ? "var(--apex-mint)" : "var(--apex-muted)");">
                        @(isLive ? "LIVE" : "FT")
                    </div>
                }
                else
                {
                    <div class="apex-display fw-bold fs-4 text-white">VS</div>
                    <div class="apex-label-caps text-muted">@Model.MatchDateTime.ToString("HH:mm")</div>
                }
            </div>

            <div class="col-4 px-1 d-flex flex-column align-items-center">
                <div class="apex-crest mb-2">@Monogram(Model.AwayTeamName)</div>
                <div class="fw-bold text-white small text-truncate w-100" title="@Model.AwayTeamName">@Model.AwayTeamName</div>
                <small class="text-muted" style="font-size: 0.72rem;">Đội khách</small>
            </div>
        </div>
    </div>

    <div class="px-3 py-2 border-top d-flex justify-content-between align-items-center gap-2" style="border-color: var(--apex-border-subtle) !important; background: rgba(28, 5, 31, 0.35);">
        <small class="text-muted text-truncate apex-tabular" style="min-width: 0;" title="@Model.PitchName">
            <i class="bi bi-geo-alt me-1" style="color: var(--apex-mint);"></i>@Model.PitchName • @Model.MatchDateTime.ToString("dd/MM")
        </small>
        <a asp-controller="Matches" asp-action="Details" asp-route-id="@Model.MatchId" class="btn btn-sm @(isLive ? "btn-apex-primary" : "btn-apex-violet") flex-shrink-0 px-3">
            Chi tiết trận
        </a>
    </div>
</article>
