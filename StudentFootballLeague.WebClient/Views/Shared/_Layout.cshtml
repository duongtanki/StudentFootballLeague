@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FPT Student Football League</title>
    <!-- Stitch Apex Broadcast Typography: Barlow Condensed + Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Bootstrap 5 CSS & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark apex-navbar py-2">
            <div class="container">
                <a class="navbar-brand apex-brand" asp-controller="Home" asp-action="Index">
                    <span class="apex-brand-icon"><i class="bi bi-trophy-fill"></i></span>
                    <span class="d-flex flex-column">
                        <span class="d-flex align-items-center gap-2">
                            <span class="apex-brand-title">FPT LEAGUE</span>
                            <span class="apex-brand-pill">SFLMS 2026</span>
                        </span>
                        <span class="apex-brand-sub d-none sm:inline d-sm-inline">Giải Bóng Đá Sinh Viên FPT</span>
                    </span>
                </a>

                <button class="navbar-toggler border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Mở menu điều hướng">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Matches" ? "active" : "")" asp-controller="Matches" asp-action="Index">Lịch thi đấu &amp; Kết quả</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Standings" ? "active" : "")" asp-controller="Standings" asp-action="Index">Bảng xếp hạng</a>
                        </li>

                        @if (User.IsInRole("TeamManager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "MyTeam" ? "active" : "")" style="color: var(--apex-violet-soft);" asp-controller="MyTeam" asp-action="Dashboard">
                                    <i class="bi bi-shield-shaded me-1"></i>Đội bóng của tôi
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(currentController == "Admin" ? "active" : "")" style="color: var(--apex-pink-soft);" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-sliders me-1"></i>Quản trị BTC
                                </a>
                                <ul class="dropdown-menu apex-dropdown-menu shadow-lg" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Tournaments"><i class="bi bi-trophy me-2"></i>Quản lý Giải &amp; Duyệt Đội</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Knockout"><i class="bi bi-diagram-3 me-2"></i>Thiết lập Vòng Knockout</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Matches"><i class="bi bi-calendar2-week me-2"></i>Lập lịch &amp; Nhập Tỷ số</a></li>
                                </ul>
                            </li>
                        }
                        else if (User.IsInRole("Referee"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Admin" ? "active" : "")" style="color: var(--apex-mint);" asp-controller="Admin" asp-action="Matches">
                                    <i class="bi bi-stopwatch me-1"></i>Điều hành trận đấu
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="apex-crest" style="width: 30px; height: 30px; font-size: 0.82rem; border-radius: 999px;">
                                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </span>
                                    <span>@User.Identity.Name</span>
                                    <span class="apex-brand-pill">@User.FindFirst(ClaimTypes.Role)?.Value</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end apex-dropdown-menu shadow-lg" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-apex-ghost btn-sm px-3" asp-controller="Auth" asp-action="Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-apex-primary btn-sm px-3" asp-controller="Auth" asp-action="Register">Đăng ký đội trưởng</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-dismissible fade show border-0 mb-4 d-flex align-items-center gap-2" style="background: rgba(0, 228, 118, 0.12); border-left: 3px solid var(--apex-mint) !important; color: #ffffff;" role="alert">
                <i class="bi bi-check-circle-fill" style="color: var(--apex-mint);"></i>
                <span>@TempData["Success"]</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-dismissible fade show border-0 mb-4 d-flex align-items-center gap-2" style="background: rgba(233, 0, 82, 0.16); border-left: 3px solid var(--apex-crimson) !important; color: #ffffff;" role="alert">
                <i class="bi bi-exclamation-triangle-fill" style="color: var(--apex-pink-soft);"></i>
                <span>@TempData["Error"]</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="apex-footer mt-auto py-3">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small">
            <span class="d-flex align-items-center gap-2">
                <span class="apex-pulse-dot" style="width: 6px; height: 6px;"></span>
                <span>&copy; 2026 FPT Student Football League — PRN232 (.NET 8.0, Web API, OData, MVC)</span>
            </span>
            <span class="apex-label-caps text-muted">Apex Broadcast System</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
