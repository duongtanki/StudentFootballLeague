@model StudentFootballLeague.BusinessLogic.DTOs.RegisterRequestDto
@{
    ViewData["Title"] = "Đăng ký Đội trưởng";
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-6">
        <div class="apex-panel overflow-hidden">
            <div class="apex-panel-header">
                <div>
                    <div class="apex-label-caps" style="color: var(--apex-mint);">TeamManager Onboarding</div>
                    <h1 class="apex-display fw-bold fs-3 mb-0 text-white">ĐĂNG KÝ TÀI KHOẢN ĐỘI TRƯỞNG</h1>
                </div>
                <i class="bi bi-person-plus-fill fs-3" style="color: var(--apex-crimson);"></i>
            </div>
            <div class="p-4">
                <p class="small text-muted mb-4">Dành cho sinh viên đại diện đội bóng lớp, khoa hoặc câu lạc bộ.</p>
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label small apex-label-caps">Họ và tên đội trưởng <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn Hải" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="StudentCode" class="form-label small apex-label-caps">Mã số sinh viên <span class="text-danger">*</span></label>
                            <input asp-for="StudentCode" class="form-control" placeholder="Ví dụ: HE180001" required />
                            <span asp-validation-for="StudentCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label small apex-label-caps">Số điện thoại <span class="text-danger">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="0901234567" required />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small apex-label-caps">Email trường cấp (@@fpt.edu.vn) <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="captain@fpt.edu.vn" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small apex-label-caps">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-apex-primary w-100 py-2 mt-2">
                        Hoàn tất đăng ký
                    </button>
                </form>

                <div class="mt-4 pt-3 border-top text-center small" style="border-color: var(--apex-border-subtle) !important;">
                    <span class="text-muted">Đã có tài khoản?</span>
                    <a asp-action="Login" class="fw-semibold text-decoration-none ms-1" style="color: var(--apex-mint);">Đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</div>
