@model StudentFootballLeague.BusinessLogic.DTOs.LoginRequestDto
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center my-4 my-md-5">
    <div class="col-md-5 col-lg-4">
        <div class="apex-panel overflow-hidden">
            <div class="apex-panel-header">
                <div>
                    <div class="apex-label-caps" style="color: var(--apex-mint);">SFLMS Portal</div>
                    <h1 class="apex-display fw-bold fs-3 mb-0 text-white">ĐĂNG NHẬP HỆ THỐNG</h1>
                </div>
                <i class="bi bi-box-arrow-in-right fs-3" style="color: var(--apex-crimson);"></i>
            </div>
            <div class="p-4">
                <form asp-action="Login" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small apex-label-caps">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="name@fpt.edu.vn" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small apex-label-caps">Mật khẩu</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-apex-primary w-100 py-2 mt-2">
                        Đăng nhập ngay
                    </button>
                </form>

                <div class="mt-4 pt-3 border-top text-center small" style="border-color: var(--apex-border-subtle) !important;">
                    <span class="text-muted">Bạn là đội trưởng mới?</span>
                    <a asp-action="Register" class="fw-semibold text-decoration-none ms-1" style="color: var(--apex-mint);">Đăng ký tài khoản đội bóng</a>
                </div>

                <div class="mt-3 p-3 rounded-2 small text-muted" style="background: var(--apex-lowest); border: 1px solid var(--apex-border-subtle);">
                    <div class="fw-bold text-white mb-1">Tài khoản mẫu (MK: <code>123456</code>)</div>
                    <div>• BTC (Admin): <code>admin@fpt.edu.vn</code></div>
                    <div>• Trọng tài: <code>referee1@fpt.edu.vn</code></div>
                    <div>• Đội trưởng SE: <code>captain.se@fpt.edu.vn</code></div>
                </div>
            </div>
        </div>
    </div>
</div>
