@{
    ViewData["Title"] = "Quản lý Giải đấu & Duyệt Đội";
    var tournaments = ViewBag.Tournaments as List<StudentFootballLeague.BusinessLogic.DTOs.TournamentReadDto> ?? new List<StudentFootballLeague.BusinessLogic.DTOs.TournamentReadDto>();
    var registrations = ViewBag.Registrations as List<StudentFootballLeague.BusinessLogic.DTOs.TeamRegistrationReadDto> ?? new List<StudentFootballLeague.BusinessLogic.DTOs.TeamRegistrationReadDto>();
    var openCount = tournaments.Count(t => t.Status == "Registering" || t.Status == "Ongoing");
    var pendingCount = registrations.Count(r => r.ApprovalStatus == "Pending");
    var approvedCount = registrations.Count(r => r.ApprovalStatus == "Approved");
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
        <div class="apex-label-caps mb-1" style="color: var(--apex-mint);">Hệ thống quản trị trung tâm • BTC FPT League</div>
        <h1 class="apex-display fw-bold mb-1" style="font-size: clamp(2rem, 3.6vw, 2.9rem);">QUẢN TRỊ MÙA GIẢI &amp; XÉT DUYỆT HỒ SƠ</h1>
        <p class="text-muted mb-0">Điều phối cấu hình giải đấu, phê duyệt hồ sơ đăng ký và phân bổ bảng đấu.</p>
    </div>
    <button type="button" class="btn btn-apex-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#createTournamentModal">
        <i class="bi bi-plus-circle-fill me-1"></i> Tạo mùa giải mới
    </button>
</div>

<!-- 4 KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="apex-kpi-card">
            <div class="apex-label-caps text-muted mb-1">Mùa giải hoạt động</div>
            <div class="apex-kpi-value" style="color: var(--apex-mint);">@openCount</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="apex-kpi-card">
            <div class="apex-label-caps text-muted mb-1">Tổng mùa giải</div>
            <div class="apex-kpi-value">@tournaments.Count</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="apex-kpi-card">
            <div class="apex-label-caps text-muted mb-1">Hồ sơ chờ duyệt</div>
            <div class="apex-kpi-value" style="color: var(--apex-amber);">@pendingCount</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="apex-kpi-card">
            <div class="apex-label-caps text-muted mb-1">Đội đã duyệt</div>
            <div class="apex-kpi-value" style="color: var(--apex-violet-soft);">@approvedCount</div>
        </div>
    </div>
</div>

<!-- Danh sách mùa giải -->
<div class="apex-panel overflow-hidden mb-4">
    <div class="apex-panel-header">
        <h2 class="apex-display fw-bold fs-4 mb-0 text-white">
            <span class="apex-section-accent me-2" style="height: 16px;"></span>BẢNG DANH SÁCH MÙA GIẢI (@tournaments.Count)
        </h2>
    </div>
    <div class="table-responsive">
        <table class="table apex-table align-middle mb-0 apex-tabular">
            <thead>
                <tr class="text-center">
                    <th>Mã</th>
                    <th class="text-start">Tên giải đấu</th>
                    <th>Học kỳ</th>
                    <th>Thời gian thi đấu</th>
                    <th>Hạn đăng ký</th>
                    <th>Quy mô đội</th>
                    <th>Cầu thủ/Đội</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in tournaments)
                {
                    <tr class="text-center">
                        <td><span class="badge bg-dark border">#@t.TournamentId</span></td>
                        <td class="text-start fw-bold text-white">@t.Name</td>
                        <td><span class="apex-badge apex-badge--scheduled">@t.Season</span></td>
                        <td>@t.StartDate.ToString("dd/MM/yyyy") – @t.EndDate.ToString("dd/MM/yyyy")</td>
                        <td>@t.RegistrationDeadline.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@t.RegisteredTeamsCount / @t.MaxTeams đội</td>
                        <td>@t.MinPlayersPerTeam – @t.MaxPlayersPerTeam</td>
                        <td>
                            @if (t.Status == "Ongoing")
                            {
                                <span class="apex-badge apex-badge--live">Đang diễn ra</span>
                            }
                            else if (t.Status == "Registering")
                            {
                                <span class="apex-badge apex-badge--scheduled">Mở đăng ký</span>
                            }
                            else if (t.Status == "Cancelled")
                            {
                                <span class="apex-badge apex-badge--cancelled">Đã hủy</span>
                            }
                            else
                            {
                                <span class="apex-badge apex-badge--completed">@t.Status</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Xét duyệt hồ sơ -->
<div class="apex-panel overflow-hidden">
    <div class="apex-panel-header flex-wrap">
        <h2 class="apex-display fw-bold fs-4 mb-0 text-white">
            <span class="apex-section-accent me-2" style="height: 16px; background: var(--apex-mint);"></span>XÉT DUYỆT HỒ SƠ ĐĂNG KÝ (@registrations.Count)
        </h2>
        <div class="d-flex flex-wrap gap-1">
            <button type="button" class="apex-tab-btn py-1 px-2 active" onclick="filterRegs('ALL', this)">Tất cả (@registrations.Count)</button>
            <button type="button" class="apex-tab-btn py-1 px-2" onclick="filterRegs('Pending', this)">Chờ duyệt (@pendingCount)</button>
            <button type="button" class="apex-tab-btn py-1 px-2" onclick="filterRegs('Approved', this)">Đã duyệt (@approvedCount)</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table apex-table align-middle mb-0 apex-tabular" id="regTable">
            <thead>
                <tr class="text-center">
                    <th class="text-start">Đội bóng</th>
                    <th>Giải đấu</th>
                    <th>Bảng đấu</th>
                    <th>Ngày nộp</th>
                    <th>Trạng thái</th>
                    <th>Thao tác xét duyệt</th>
                </tr>
            </thead>
            <tbody>
                @if (registrations.Any())
                {
                    foreach (var reg in registrations)
                    {
                        var initials = reg.TeamName.Length >= 2 ? reg.TeamName.Substring(0, 2).ToUpper() : reg.TeamName.ToUpper();
                        <tr class="text-center reg-row" data-status="@reg.ApprovalStatus">
                            <td class="text-start">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="apex-crest" style="width: 34px; height: 34px; font-size: 0.85rem;">@initials</span>
                                    <span class="fw-bold text-white">@reg.TeamName</span>
                                </div>
                            </td>
                            <td>@reg.TournamentName</td>
                            <td>
                                <span class="apex-badge @(!string.IsNullOrEmpty(reg.GroupName) ? "apex-badge--scheduled" : "apex-badge--completed")">
                                    @(reg.GroupName ?? "Chưa phân bảng")
                                </span>
                            </td>
                            <td>@reg.RegisteredAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (reg.ApprovalStatus == "Approved")
                                {
                                    <span class="apex-badge apex-badge--live">Đã duyệt</span>
                                }
                                else if (reg.ApprovalStatus == "Pending")
                                {
                                    <span class="apex-badge apex-badge--postponed">Chờ duyệt</span>
                                }
                                else
                                {
                                    <span class="apex-badge apex-badge--cancelled" title="@reg.RejectReason">Bị từ chối</span>
                                }
                            </td>
                            <td>
                                @if (reg.ApprovalStatus == "Pending")
                                {
                                    <form asp-action="ApproveRegistration" method="post" class="d-inline-flex gap-2 align-items-center">
                                        <input type="hidden" name="id" value="@reg.RegistrationId" />
                                        <select name="groupName" class="form-select form-select-sm" style="width: 110px;">
                                            <option value="Group A">Bảng A</option>
                                            <option value="Group B">Bảng B</option>
                                        </select>
                                        <button type="submit" name="status" value="Approved" class="btn btn-apex-mint btn-sm px-3">
                                            <i class="bi bi-check-lg me-1"></i>Duyệt
                                        </button>
                                        <button type="submit" name="status" value="Rejected" class="btn btn-outline-danger btn-sm">
                                            Từ chối
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="small text-muted">Đã hoàn tất</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Chưa có hồ sơ đăng ký nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Tạo Mùa Giải Mới -->
<div class="modal fade apex-modal" id="createTournamentModal" tabindex="-1" aria-labelledby="createTournamentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="CreateTournament" method="post">
                <div class="modal-header">
                    <h5 class="modal-title apex-display fw-bold fs-4" id="createTournamentModalLabel">
                        <i class="bi bi-trophy me-2" style="color: var(--apex-crimson);"></i>TẠO MÙA GIẢI BÓNG ĐÁ MỚI
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small apex-label-caps">Tên giải đấu <span class="text-danger">*</span></label>
                        <input name="Name" class="form-control" placeholder="Ví dụ: Giải Bóng đá Sinh viên FPT Cup Mùa Xuân 2027" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small apex-label-caps">Kỳ / Năm học <span class="text-danger">*</span></label>
                            <input name="Season" class="form-control" placeholder="Ví dụ: Spring 2027" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small apex-label-caps">Số đội tối đa <span class="text-danger">*</span></label>
                            <select name="MaxTeams" class="form-select" required>
                                <option value="8" selected>8 đội (2 bảng)</option>
                                <option value="12">12 đội (3 bảng)</option>
                                <option value="16">16 đội (4 bảng)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small apex-label-caps">Ngày khai mạc <span class="text-danger">*</span></label>
                            <input name="StartDate" type="date" class="form-control" value="2027-03-01" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small apex-label-caps">Ngày bế mạc <span class="text-danger">*</span></label>
                            <input name="EndDate" type="date" class="form-control" value="2027-03-31" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small apex-label-caps">Hạn chót đăng ký <span class="text-danger">*</span></label>
                            <input name="RegistrationDeadline" type="datetime-local" class="form-control" value="2027-02-25T23:59" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small apex-label-caps">Tối thiểu cầu thủ</label>
                            <input name="MinPlayersPerTeam" type="number" class="form-control apex-tabular" value="7" min="7" max="20" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small apex-label-caps">Tối đa cầu thủ</label>
                            <input name="MaxPlayersPerTeam" type="number" class="form-control apex-tabular" value="15" min="7" max="25" required />
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label small apex-label-caps">Trạng thái ban đầu</label>
                        <select name="Status" class="form-select">
                            <option value="Registering" selected>Mở đăng ký (Registering)</option>
                            <option value="Ongoing">Đang diễn ra (Ongoing)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-apex-ghost" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-apex-primary px-4">Lưu mùa giải</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterRegs(status, btn) {
            document.querySelectorAll('#regTable .reg-row').forEach(function (row) {
                row.style.display = (status === 'ALL' || row.getAttribute('data-status') === status) ? '' : 'none';
            });
            btn.parentElement.querySelectorAll('button').forEach(function (b) { b.classList.remove('active'); });
            btn.classList.add('active');
        }
    </script>
}
