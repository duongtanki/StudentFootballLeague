@model StudentFootballLeague.BusinessLogic.DTOs.MatchReadDto
@using StudentFootballLeague.BusinessLogic.DTOs
@{
    ViewData["Title"] = $"Chi tiết trận đấu: {Model.HomeTeamName} vs {Model.AwayTeamName}";
    var homePlayers = ViewBag.HomePlayers as List<PlayerReadDto> ?? new List<PlayerReadDto>();
    var awayPlayers = ViewBag.AwayPlayers as List<PlayerReadDto> ?? new List<PlayerReadDto>();
    var isLive = string.Equals(Model.Status, "InProgress", StringComparison.OrdinalIgnoreCase);
    var showScore = isLive || string.Equals(Model.Status, "Completed", StringComparison.OrdinalIgnoreCase);

    var events = (Model.Events ?? new List<MatchEventReadDto>()).OrderBy(e => e.Minute).ToList();
    var totalGoals = events.Count(e => e.EventType == "Goal" || e.EventType == "PenaltyGoal" || e.EventType == "OwnGoal");
    var homeYellow = events.Count(e => e.TeamId == Model.HomeTeamId && e.EventType == "YellowCard");
    var homeRed = events.Count(e => e.TeamId == Model.HomeTeamId && e.EventType == "RedCard");
    var awayYellow = events.Count(e => e.TeamId == Model.AwayTeamId && e.EventType == "YellowCard");
    var awayRed = events.Count(e => e.TeamId == Model.AwayTeamId && e.EventType == "RedCard");

    var eventPlayerIds = events.Select(e => e.PlayerId).ToHashSet();

    int PosOrder(string? pos) => pos switch
    {
        "GK" => 0,
        "DF" => 1,
        "MF" => 2,
        "FW" => 3,
        _ => 4
    };

    string PosLabel(string? pos) => pos switch
    {
        "GK" => "GK - Thủ môn",
        "DF" => "DF - Hậu vệ",
        "MF" => "MF - Tiền vệ",
        "FW" => "FW - Tiền đạo",
        _ => pos ?? "N/A"
    };

    (List<PlayerReadDto> Starters, List<PlayerReadDto> Subs) SplitLineup(List<PlayerReadDto> squad)
    {
        var starters = squad
            .OrderByDescending(p => eventPlayerIds.Contains(p.PlayerId))
            .ThenBy(p => p.PlayerId)
            .Take(7)
            .OrderBy(p => PosOrder(p.Position))
            .ThenBy(p => p.JerseyNumber)
            .ToList();

        var starterIds = starters.Select(p => p.PlayerId).ToHashSet();

        var subs = squad
            .Where(p => !starterIds.Contains(p.PlayerId))
            .OrderBy(p => PosOrder(p.Position))
            .ThenBy(p => p.JerseyNumber)
            .ToList();

        return (starters, subs);
    }

    var (homeStarters, homeSubs) = SplitLineup(homePlayers);
    var (awayStarters, awaySubs) = SplitLineup(awayPlayers);

    string Monogram(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "FC";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-apex-ghost btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Quay lại lịch thi đấu
    </a>
</div>

<!-- Match Broadcast Header -->
<section class="apex-hero p-4 p-md-5 mb-4">
    <div class="text-center mb-4 position-relative" style="z-index: 2;">
        <span class="apex-badge apex-badge--scheduled mb-2">
            @Model.TournamentName • @Model.RoundName @(string.IsNullOrEmpty(Model.GroupName) ? "" : $"({Model.GroupName})")
        </span>
        <div class="small text-muted apex-tabular">
            <i class="bi bi-geo-alt me-1" style="color: var(--apex-mint);"></i>@Model.PitchName
            <span class="mx-2">•</span>
            <i class="bi bi-clock me-1"></i>@Model.MatchDateTime.ToString("HH:mm - dd/MM/yyyy")
            @if (!string.IsNullOrEmpty(Model.RefereeName))
            {
                <span class="mx-2">•</span>
                <span>Trọng tài: <strong class="text-white">@Model.RefereeName</strong></span>
            }
        </div>
    </div>

    <div class="row align-items-center text-center g-3 position-relative" style="z-index: 2;">
        <div class="col-4 d-flex flex-column align-items-center">
            <span class="apex-badge apex-badge--live mb-2" style="font-size: 0.7rem;">Chủ nhà</span>
            <div class="apex-crest apex-crest--lg mb-2">@Monogram(Model.HomeTeamName)</div>
            <h1 class="h3 apex-display fw-bold text-white mb-0">@Model.HomeTeamName</h1>
        </div>

        <div class="col-4">
            @if (showScore)
            {
                <div class="apex-display fw-bold apex-tabular @(isLive ? "apex-score--live" : "text-white")" style="font-size: clamp(2.8rem, 6vw, 4.2rem); line-height: 1;">
                    @Model.HomeScore <span class="text-muted">:</span> @Model.AwayScore
                </div>
                @if (Model.HomePenalty.HasValue && Model.AwayPenalty.HasValue)
                {
                    <div class="small mt-1 apex-tabular" style="color: var(--apex-violet-soft);">Luân lưu: @Model.HomePenalty - @Model.AwayPenalty</div>
                }
            }
            else
            {
                <div class="apex-display fw-bold fs-1 text-white">VS</div>
            }
            <div class="mt-3">
                <match-status status="@Model.Status"></match-status>
            </div>
        </div>

        <div class="col-4 d-flex flex-column align-items-center">
            <span class="apex-badge apex-badge--scheduled mb-2" style="font-size: 0.7rem;">Đội khách</span>
            <div class="apex-crest apex-crest--lg mb-2">@Monogram(Model.AwayTeamName)</div>
            <h1 class="h3 apex-display fw-bold text-white mb-0">@Model.AwayTeamName</h1>
        </div>
    </div>

    <!-- Match Telemetry Strip -->
    <div class="row g-3 mt-4 pt-3 border-top text-center position-relative" style="z-index: 2; border-color: var(--apex-border) !important;">
        <div class="col-4">
            <div class="apex-label-caps text-muted">Tổng sự kiện</div>
            <div class="apex-display fw-bold fs-4 text-white apex-tabular">@events.Count</div>
        </div>
        <div class="col-4">
            <div class="apex-label-caps text-muted">Bàn thắng ghi nhận</div>
            <div class="apex-display fw-bold fs-4 apex-tabular" style="color: var(--apex-mint);">@totalGoals</div>
        </div>
        <div class="col-4">
            <div class="apex-label-caps text-muted">Thẻ phạt (Vàng / Đỏ)</div>
            <div class="apex-display fw-bold fs-5 text-white apex-tabular">
                <span class="text-warning">@homeYellow</span> / <span style="color: var(--apex-crimson);">@homeRed</span>
                <span class="text-muted mx-1">vs</span>
                <span class="text-warning">@awayYellow</span> / <span style="color: var(--apex-crimson);">@awayRed</span>
            </div>
        </div>
    </div>
</section>

<!-- Diễn biến trận đấu 2 bên (Home Left | Minute Axis Center | Away Right) -->
<section class="apex-panel mb-4">
    <div class="apex-panel-header">
        <div>
            <h2 class="apex-display fw-bold fs-4 mb-0 text-white">
                <i class="bi bi-stopwatch me-2" style="color: var(--apex-crimson);"></i>DIỄN BIẾN TRẬN ĐẤU
            </h2>
            <small class="text-muted">Phân tách hai bên Chủ nhà &amp; Đội khách theo mốc phút</small>
        </div>
        <span class="apex-badge apex-badge--live">@events.Count sự kiện</span>
    </div>
    <div class="p-3 p-md-4">
        @if (events.Any())
        {
            <div class="d-none d-md-grid mb-3 text-uppercase apex-label-caps text-muted" style="grid-template-columns: 1fr 72px 1fr; gap: 0.75rem;">
                <div class="text-end" style="color: var(--apex-mint);">@Model.HomeTeamName (Chủ nhà)</div>
                <div class="text-center">Phút</div>
                <div class="text-start" style="color: var(--apex-pink-soft);">@Model.AwayTeamName (Đội khách)</div>
            </div>

            <div class="apex-split-timeline">
                @foreach (var ev in events)
                {
                    var isHomeEvent = Model.HomeTeamId.HasValue && ev.TeamId == Model.HomeTeamId.Value;
                    var isYellow = ev.EventType == "YellowCard";
                    var isRed = ev.EventType == "RedCard";
                    var cardMod = isYellow ? "apex-split-card--yellow" : (isRed ? "apex-split-card--red" : "");
                    var iconMod = isYellow ? "apex-split-icon--yellow" : (isRed ? "apex-split-icon--red" : "apex-split-icon--goal");
                    var iconClass = isYellow ? "bi-square-fill" : (isRed ? "bi-square-fill" : "bi-dribbble");
                    var badgeText = ev.EventType switch
                    {
                        "Goal" => "Bàn thắng",
                        "PenaltyGoal" => "Phạt đền (P)",
                        "OwnGoal" => "Phản lưới",
                        "YellowCard" => "Thẻ vàng",
                        "RedCard" => "Thẻ đỏ",
                        _ => ev.EventType
                    };
                    var badgeClass = ev.EventType switch
                    {
                        "Goal" or "PenaltyGoal" => "apex-badge--live",
                        "OwnGoal" => "apex-badge--scheduled",
                        "YellowCard" => "apex-badge--postponed",
                        "RedCard" => "apex-badge--cancelled",
                        _ => "apex-badge--scheduled"
                    };

                    <div class="apex-split-row">
                        @if (isHomeEvent)
                        {
                            <div class="apex-split-cell--home">
                                <div class="apex-split-card apex-split-card--home @cardMod">
                                    <div class="d-flex flex-wrap align-items-center justify-content-md-end gap-2 mb-1">
                                        <span class="apex-badge @badgeClass">@badgeText</span>
                                        <span class="fw-bold text-white">@ev.PlayerName <span class="text-muted apex-tabular">#@ev.JerseyNumber</span></span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(ev.Description))
                                    {
                                        <small class="text-muted d-block">@ev.Description</small>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="apex-split-cell--empty"></div>
                        }

                        <div class="apex-split-node">
                            <span class="apex-split-icon @iconMod">
                                <i class="bi @iconClass"></i>
                            </span>
                            <span class="apex-split-minute apex-tabular">@ev.Minute'</span>
                        </div>

                        @if (!isHomeEvent)
                        {
                            <div class="apex-split-cell--away">
                                <div class="apex-split-card apex-split-card--away @cardMod">
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                        <span class="apex-badge @badgeClass">@badgeText</span>
                                        <span class="fw-bold text-white">@ev.PlayerName <span class="text-muted apex-tabular">#@ev.JerseyNumber</span></span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(ev.Description))
                                    {
                                        <small class="text-muted d-block">@ev.Description</small>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="apex-split-cell--empty"></div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-journal-x fs-1 d-block mb-2"></i>
                <p class="mb-0">Chưa có sự kiện nào được ghi nhận trong trận đấu này.</p>
            </div>
        }
    </div>
</section>

<!-- Đội hình đăng ký theo hàng dọc (7 Chính thức + Dự bị) -->
<div class="row g-4">
    @{
        var teamPanels = new[]
        {
            new { TeamName = Model.HomeTeamName, RoleLabel = "CHỦ NHÀ", AccentColor = "var(--apex-mint)", BadgeClass = "apex-badge--live", Starters = homeStarters, Subs = homeSubs, TotalCount = homePlayers.Count },
            new { TeamName = Model.AwayTeamName, RoleLabel = "ĐỘI KHÁCH", AccentColor = "var(--apex-pink-soft)", BadgeClass = "apex-badge--scheduled", Starters = awayStarters, Subs = awaySubs, TotalCount = awayPlayers.Count }
        };
    }

    @foreach (var team in teamPanels)
    {
        <div class="col-lg-6">
            <div class="apex-panel h-100">
                <div class="apex-panel-header">
                    <div class="d-flex align-items-center gap-2 min-w-0">
                        <div class="apex-crest" style="width: 38px; height: 38px; font-size: 0.9rem;">@Monogram(team.TeamName)</div>
                        <div class="min-w-0">
                            <h2 class="h5 apex-display fw-bold mb-0 text-white text-truncate">@team.TeamName</h2>
                            <span class="apex-label-caps" style="color: @team.AccentColor; font-size: 0.7rem;">@team.RoleLabel • Sân 7 người</span>
                        </div>
                    </div>
                    <span class="apex-badge @team.BadgeClass apex-tabular">@team.TotalCount cầu thủ</span>
                </div>

                <div class="p-3 p-md-4">
                    <!-- Đội hình chính thức (Starting 7) -->
                    <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom" style="border-color: var(--apex-border) !important;">
                        <span class="apex-label-caps text-white">
                            <i class="bi bi-person-check-fill me-1" style="color: @team.AccentColor;"></i>ĐỘI HÌNH CHÍNH THỨC (STARTING 7)
                        </span>
                        <span class="small text-muted apex-tabular">@team.Starters.Count cầu thủ</span>
                    </div>

                    @if (team.Starters.Any())
                    {
                        <div class="d-flex flex-column gap-2 mb-4">
                            @foreach (var p in team.Starters)
                            {
                                var pEvents = events.Where(e => e.PlayerId == p.PlayerId).ToList();
                                <div class="apex-lineup-row">
                                    <div class="d-flex align-items-center gap-2 min-w-0">
                                        <span class="badge bg-dark border apex-tabular" style="min-width: 34px;">#@p.JerseyNumber</span>
                                        <div class="min-w-0">
                                            <div class="small fw-semibold text-white text-truncate">@p.FullName</div>
                                            <div class="text-muted" style="font-size: 0.72rem;">MSSV: @p.StudentCode</div>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        @foreach (var pe in pEvents)
                                        {
                                            if (pe.EventType == "Goal" || pe.EventType == "PenaltyGoal")
                                            {
                                                <span class="apex-badge apex-badge--live apex-tabular" style="font-size: 0.68rem;">
                                                    <i class="bi bi-dribbble me-1"></i>@pe.Minute'@(pe.EventType == "PenaltyGoal" ? " (P)" : "")
                                                </span>
                                            }
                                            else if (pe.EventType == "YellowCard")
                                            {
                                                <span class="apex-badge apex-badge--postponed apex-tabular" style="font-size: 0.68rem;">
                                                    <i class="bi bi-square-fill me-1"></i>@pe.Minute'
                                                </span>
                                            }
                                            else if (pe.EventType == "RedCard")
                                            {
                                                <span class="apex-badge apex-badge--cancelled apex-tabular" style="font-size: 0.68rem;">
                                                    <i class="bi bi-square-fill me-1"></i>@pe.Minute'
                                                </span>
                                            }
                                        }
                                        <span class="apex-pos-pill apex-pos-pill--@p.Position">@PosLabel(p.Position)</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="small text-muted mb-4">Chưa cập nhật danh sách cầu thủ chính thức.</p>
                    }

                    <!-- Đội hình dự bị (Substitutes) -->
                    <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom" style="border-color: var(--apex-border) !important;">
                        <span class="apex-label-caps text-muted">
                            <i class="bi bi-people me-1" style="color: var(--apex-violet-soft);"></i>ĐỘI HÌNH DỰ BỊ (SUBSTITUTES)
                        </span>
                        <span class="small text-muted apex-tabular">@team.Subs.Count dự bị</span>
                    </div>

                    @if (team.Subs.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var p in team.Subs)
                            {
                                <div class="apex-lineup-row apex-lineup-row--sub">
                                    <div class="d-flex align-items-center gap-2 min-w-0">
                                        <span class="badge bg-dark border apex-tabular text-muted" style="min-width: 34px;">#@p.JerseyNumber</span>
                                        <div class="min-w-0">
                                            <div class="small text-white-50 text-truncate">@p.FullName</div>
                                            <div class="text-muted" style="font-size: 0.72rem;">MSSV: @p.StudentCode</div>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        <span class="apex-pos-pill apex-pos-pill--@p.Position">@PosLabel(p.Position)</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="small text-muted mb-0">Chưa có cầu thủ dự bị đăng ký.</p>
                    }
                </div>
            </div>
        </div>
    }
</div>
