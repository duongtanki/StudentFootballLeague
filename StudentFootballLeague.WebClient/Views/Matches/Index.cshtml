@model IEnumerable<StudentFootballLeague.BusinessLogic.DTOs.MatchReadDto>
@{
    ViewData["Title"] = "Lịch thi đấu & Kết quả";
    var tournaments = ViewBag.Tournaments as List<StudentFootballLeague.BusinessLogic.DTOs.TournamentReadDto> ?? new List<StudentFootballLeague.BusinessLogic.DTOs.TournamentReadDto>();
    var availableGroups = ViewBag.AvailableGroups as List<string> ?? new List<string>();
    var availableRounds = ViewBag.AvailableRounds as List<string> ?? new List<string>();

    int? selectedTournament = ViewBag.SelectedTournament as int?;
    string selectedStatus = ViewBag.SelectedStatus as string ?? "all";
    string? selectedGroup = ViewBag.SelectedGroup as string;
    string? selectedRound = ViewBag.SelectedRound as string;
    string? searchTeam = ViewBag.SearchTeam as string;

    var allMatches = (Model ?? Enumerable.Empty<StudentFootballLeague.BusinessLogic.DTOs.MatchReadDto>()).ToList();
    var totalCount = allMatches.Count;
    var liveCount = allMatches.Count(m => m.Status == "InProgress");
    var scheduledCount = allMatches.Count(m => m.Status == "Scheduled");
    var totalGoals = allMatches.Sum(m => (m.HomeScore ?? 0) + (m.AwayScore ?? 0));

    var groupedByDate = allMatches
        .GroupBy(m => m.MatchDateTime.Date)
        .OrderByDescending(g => g.Key)
        .ToList();

    string FormatVietnameseDate(DateTime date)
    {
        var dayOfWeek = date.DayOfWeek switch
        {
            DayOfWeek.Monday => "Thứ Hai",
            DayOfWeek.Tuesday => "Thứ Ba",
            DayOfWeek.Wednesday => "Thứ Tư",
            DayOfWeek.Thursday => "Thứ Năm",
            DayOfWeek.Friday => "Thứ Sáu",
            DayOfWeek.Saturday => "Thứ Bảy",
            DayOfWeek.Sunday => "Chủ Nhật",
            _ => ""
        };
        return $"{dayOfWeek}, {date:dd} tháng {date:MM}, {date:yyyy}";
    }

    string FormatGroupName(string? groupName)
    {
        if (string.IsNullOrWhiteSpace(groupName)) return "";
        if (groupName.StartsWith("Group ", StringComparison.OrdinalIgnoreCase))
            return "Bảng " + groupName.Substring(6);
        return groupName;
    }

    string Monogram(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "FC";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
        <div class="apex-label-caps mb-1" style="color: var(--apex-crimson);">
            FPT Student Football League • Match Center
        </div>
        <h1 class="apex-display fw-bold mb-1" style="font-size: clamp(2rem, 3.6vw, 2.9rem);">LỊCH THI ĐẤU &amp; KẾT QUẢ</h1>
        <p class="text-muted mb-0">Theo dõi trực tiếp diễn biến các trận đấu vòng bảng và vòng loại trực tiếp.</p>
    </div>

    <form method="get" class="d-flex flex-column align-items-md-end">
        <input type="hidden" name="status" value="@selectedStatus" />
        <input type="hidden" name="groupName" value="@selectedGroup" />
        <input type="hidden" name="roundName" value="@selectedRound" />
        <input type="hidden" name="searchTeam" value="@searchTeam" />
        <label class="apex-label-caps text-muted mb-1">Mùa giải đang chọn</label>
        <select name="tournamentId" class="form-select form-select-sm" style="min-width: 260px;" onchange="this.form.submit()">
            <option value="">Tất cả mùa giải</option>
            @foreach (var t in tournaments)
            {
                <option value="@t.TournamentId" selected="@(selectedTournament == t.TournamentId ? "selected" : null)">
                    @t.Name (@t.Season)
                </option>
            }
        </select>
    </form>
</div>

<!-- 4 KPI Telemetry Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="apex-kpi-card d-flex justify-content-between align-items-center">
            <div>
                <div class="apex-label-caps text-muted mb-1">Tổng trận</div>
                <div class="apex-kpi-value">@totalCount</div>
            </div>
            <span class="apex-crest" style="color: var(--apex-pink-soft);"><i class="bi bi-dribbble"></i></span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="apex-kpi-card d-flex justify-content-between align-items-center">
            <div>
                <div class="apex-label-caps text-muted mb-1">Đang diễn ra</div>
                <div class="apex-kpi-value" style="color: var(--apex-mint);">@liveCount</div>
            </div>
            <span class="apex-crest" style="color: var(--apex-mint);"><i class="bi bi-broadcast"></i></span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="apex-kpi-card d-flex justify-content-between align-items-center">
            <div>
                <div class="apex-label-caps text-muted mb-1">Sắp tranh tài</div>
                <div class="apex-kpi-value" style="color: var(--apex-violet-soft);">@scheduledCount</div>
            </div>
            <span class="apex-crest" style="color: var(--apex-violet-soft);"><i class="bi bi-clock"></i></span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="apex-kpi-card d-flex justify-content-between align-items-center">
            <div>
                <div class="apex-label-caps text-muted mb-1">Tổng bàn thắng</div>
                <div class="apex-kpi-value" style="color: var(--apex-crimson);">@totalGoals</div>
            </div>
            <span class="apex-crest" style="color: var(--apex-crimson);"><i class="bi bi-bullseye"></i></span>
        </div>
    </div>
</div>

<!-- Status Filter Tabs & Search Bar -->
<div class="apex-panel p-3 mb-4">
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a asp-action="Index" asp-route-tournamentId="@selectedTournament" asp-route-status="all" asp-route-groupName="@selectedGroup" asp-route-roundName="@selectedRound" asp-route-searchTeam="@searchTeam"
           class="apex-tab-btn @(selectedStatus == "all" ? "active" : "")">
            Tất cả trận
        </a>
        <a asp-action="Index" asp-route-tournamentId="@selectedTournament" asp-route-status="upcoming" asp-route-groupName="@selectedGroup" asp-route-roundName="@selectedRound" asp-route-searchTeam="@searchTeam"
           class="apex-tab-btn @(selectedStatus == "upcoming" ? "active" : "")">
            Sắp diễn ra
        </a>
        <a asp-action="Index" asp-route-tournamentId="@selectedTournament" asp-route-status="completed" asp-route-groupName="@selectedGroup" asp-route-roundName="@selectedRound" asp-route-searchTeam="@searchTeam"
           class="apex-tab-btn @(selectedStatus == "completed" ? "active" : "")">
            Đã kết thúc
        </a>
    </div>

    <form method="get" class="row g-2 align-items-center">
        <input type="hidden" name="tournamentId" value="@selectedTournament" />
        <input type="hidden" name="status" value="@selectedStatus" />
        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text border-0" style="background: var(--apex-lowest); color: var(--apex-muted);"><i class="bi bi-search"></i></span>
                <input type="text" name="searchTeam" class="form-control" placeholder="Tìm theo tên đội bóng..." value="@searchTeam" />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select name="groupName" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">Tất cả bảng đấu</option>
                @foreach (var g in availableGroups)
                {
                    <option value="@g" selected="@(string.Equals(selectedGroup, g, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                        @FormatGroupName(g)
                    </option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <select name="roundName" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">Tất cả vòng đấu</option>
                @foreach (var r in availableRounds)
                {
                    <option value="@r" selected="@(string.Equals(selectedRound, r, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                        @r
                    </option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-apex-primary btn-sm flex-grow-1">Lọc</button>
            <a asp-action="Index" asp-route-tournamentId="@selectedTournament" class="btn btn-apex-ghost btn-sm" title="Đặt lại bộ lọc">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Date-Grouped Matches List -->
@if (groupedByDate.Any())
{
    foreach (var dateGroup in groupedByDate)
    {
        var matchesInDay = dateGroup.OrderBy(m => m.MatchDateTime).ToList();
        var roundLabel = string.Join(" • ", matchesInDay.Select(m => m.RoundName).Distinct());

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4 mb-3">
            <div class="d-flex align-items-center gap-2">
                <span class="apex-section-accent" style="height: 20px;"></span>
                <h2 class="apex-display fw-bold fs-4 mb-0 text-uppercase">@FormatVietnameseDate(dateGroup.Key)</h2>
                <span class="text-muted small">• @roundLabel</span>
            </div>
            <span class="apex-badge apex-badge--scheduled">@matchesInDay.Count trận đấu</span>
        </div>

        <div class="d-flex flex-column gap-3">
            @foreach (var m in matchesInDay)
            {
                var isLive = m.Status == "InProgress";
                var showScore = isLive || m.Status == "Completed";
                var goals = m.Events?.Where(e => e.EventType == "Goal" || e.EventType == "PenaltyGoal").OrderBy(e => e.Minute).ToList() ?? new List<StudentFootballLeague.BusinessLogic.DTOs.MatchEventReadDto>();

                <article class="apex-match-card @(isLive ? "apex-match-card--live" : "") p-3 p-md-4">
                    <div class="row align-items-center g-3">
                        <!-- Time & Pitch -->
                        <div class="col-lg-3 d-flex flex-lg-column justify-content-between align-items-lg-start gap-2">
                            <div>
                                <div class="apex-display fw-bold fs-4 text-white apex-tabular lh-1">@m.MatchDateTime.ToString("HH:mm")</div>
                                <small class="text-muted"><i class="bi bi-geo-alt me-1" style="color: var(--apex-mint);"></i>@m.PitchName</small>
                            </div>
                            @if (!string.IsNullOrEmpty(m.GroupName))
                            {
                                <span class="apex-badge apex-badge--scheduled">@FormatGroupName(m.GroupName)</span>
                            }
                            else
                            {
                                <span class="apex-badge apex-badge--live">@m.RoundName @(!string.IsNullOrEmpty(m.BranchName) && m.BranchName != m.RoundName ? $"• {m.BranchName}" : "")</span>
                            }
                        </div>

                        <!-- Matchup & Score -->
                        <div class="col-lg-6">
                            <div class="row align-items-center text-center g-2">
                                <div class="col-5 d-flex align-items-center justify-content-end gap-2">
                                    <div class="text-end min-w-0">
                                        <div class="fw-bold text-white text-truncate">@m.HomeTeamName</div>
                                        <small class="text-muted" style="font-size: 0.72rem;">Chủ nhà</small>
                                    </div>
                                    <span class="apex-crest d-none d-sm-inline-flex">@Monogram(m.HomeTeamName)</span>
                                </div>

                                <div class="col-2">
                                    @if (showScore)
                                    {
                                        <div class="apex-score @(isLive ? "apex-score--live" : "")" style="font-size: 2rem;">
                                            @m.HomeScore - @m.AwayScore
                                        </div>
                                        @if (m.HomePenalty.HasValue && m.AwayPenalty.HasValue)
                                        {
                                            <small class="d-block apex-tabular" style="color: var(--apex-violet-soft);">Pen @m.HomePenalty - @m.AwayPenalty</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="apex-display fw-bold fs-4 text-white">VS</span>
                                    }
                                </div>

                                <div class="col-5 d-flex align-items-center justify-content-start gap-2">
                                    <span class="apex-crest d-none d-sm-inline-flex">@Monogram(m.AwayTeamName)</span>
                                    <div class="text-start min-w-0">
                                        <div class="fw-bold text-white text-truncate">@m.AwayTeamName</div>
                                        <small class="text-muted" style="font-size: 0.72rem;">Đội khách</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Status & Action -->
                        <div class="col-lg-3 d-flex justify-content-between justify-content-lg-end align-items-center gap-2">
                            <match-status status="@m.Status"></match-status>
                            <a asp-action="Details" asp-route-id="@m.MatchId" class="btn btn-sm @(isLive ? "btn-apex-primary" : "btn-apex-ghost") px-3">
                                Chi tiết <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>

                    @if (goals.Any() || !string.IsNullOrEmpty(m.RefereeName))
                    {
                        <div class="mt-3 pt-2 border-top d-flex flex-wrap justify-content-between align-items-center gap-2 small" style="border-color: var(--apex-border-subtle) !important;">
                            <div style="color: var(--apex-mint);">
                                @if (goals.Any())
                                {
                                    <i class="bi bi-bullseye me-1"></i>
                                    @string.Join(" • ", goals.Select(g => $"{g.PlayerName} {g.Minute}'{(g.EventType == "PenaltyGoal" ? " (Pen)" : "")}"))
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(m.RefereeName))
                            {
                                <span class="apex-label-caps text-muted">Trọng tài: @m.RefereeName</span>
                            }
                        </div>
                    }
                </article>
            }
        </div>
    }
}
else
{
    <div class="apex-panel p-5 text-center text-muted">
        <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
        <h5 class="fw-bold text-white">Không tìm thấy trận đấu phù hợp</h5>
        <p class="mb-3">Thử thay đổi điều kiện lọc hoặc quay lại xem tất cả các trận.</p>
        <a asp-action="Index" class="btn btn-sm btn-apex-primary">Xem tất cả trận đấu</a>
    </div>
}
