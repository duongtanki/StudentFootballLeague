@model IEnumerable<StudentFootballLeague.BusinessLogic.DTOs.MatchReadDto>
@{
    ViewData["Title"] = "Lịch thi đấu & Kết quả";
    var tournaments = ViewBag.Tournaments as List<StudentFootballLeague.BusinessLogic.DTOs.TournamentReadDto> ?? new List<StudentFootballLeague.BusinessLogic.DTOs.TournamentReadDto>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-calendar3 me-2 text-primary"></i>Lịch Thi Đấu & Kết Quả</h3>
        <p class="text-muted mb-0">Theo dõi tỷ số trực tiếp, lịch thi đấu vòng bảng và vòng loại trực tiếp</p>
    </div>
</div>

<!-- Bộ lọc tìm kiếm OData -->
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold">Mùa giải</label>
                <select name="tournamentId" class="form-select form-select-sm">
                    <option value="">-- Tất cả mùa giải --</option>
                    @foreach (var t in tournaments)
                    {
                        <option value="@t.TournamentId" selected="@(ViewBag.SelectedTournament == t.TournamentId ? "selected" : null)">
                            @t.Name (@t.Season)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Bảng đấu</label>
                <select name="groupName" class="form-select form-select-sm">
                    <option value="">-- Tất cả bảng --</option>
                    <option value="Group A" selected="@(ViewBag.SelectedGroup == "Group A" ? "selected" : null)">Bảng A (Group A)</option>
                    <option value="Group B" selected="@(ViewBag.SelectedGroup == "Group B" ? "selected" : null)">Bảng B (Group B)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Vòng đấu</label>
                <input type="text" name="roundName" class="form-control form-control-sm" placeholder="VD: Vòng Bảng, Bán Kết..." value="@ViewBag.SelectedRound" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Tên đội bóng</label>
                <input type="text" name="searchTeam" class="form-control form-control-sm" placeholder="VD: FC Kỹ Thuật..." value="@ViewBag.SearchTeam" />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                    <i class="bi bi-search"></i> Lọc
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách trận đấu -->
@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var match in Model)
        {
            <div class="col-md-6 mb-4">
                @await Html.PartialAsync("_MatchScoreCardPartial", match)
            </div>
        }
    </div>
}
else
{
    <div class="card shadow-sm border-0 p-5 text-center text-muted">
        <i class="bi bi-inbox fs-1 mb-2"></i>
        <h5 class="fw-bold">Không tìm thấy trận đấu nào</h5>
        <p class="mb-0">Thử thay đổi bộ lọc tìm kiếm hoặc quay lại sau.</p>
    </div>
}
